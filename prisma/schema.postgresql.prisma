generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum untuk Role Aktor
enum Role {
  ADMIN
  CUSTOMER
}

// Enum untuk Status Pesanan (Booking)
enum BookingStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// Enum untuk Status Pembayaran Sandbox
enum PaymentStatus {
  UNPAID
  PAID
  FAILED
}

// 1. Tabel User (Admin & Customer)
model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  password  String
  phone     String?
  role      Role      @default(CUSTOMER)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  bookings  Booking[]

  @@map("users")
}

// 2. Tabel Trip (Paket Open Trip)
model Trip {
  id             Int       @id @default(autoincrement())
  title          String
  destination    String
  price          Decimal   @db.Decimal(12, 2)
  departureDate  DateTime  @map("departure_date")
  maxQuota       Int       @map("max_quota")
  remainingQuota Int       @map("remaining_quota")
  description    String    @db.Text
  imageUrl       String?   @map("image_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  bookings       Booking[]

  @@map("trips")
}

// 3. Tabel Booking (Pesanan Customer)
model Booking {
  id           Int           @id @default(autoincrement())
  bookingCode  String        @unique @map("booking_code")
  userId       Int           @map("user_id")
  tripId       Int           @map("trip_id")
  participants Int
  notes        String?       @db.Text
  totalAmount  Decimal       @map("total_amount") @db.Decimal(12, 2)
  status       BookingStatus @default(PENDING)
  bookingDate  DateTime      @default(now()) @map("booking_date")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip         Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payment      Payment?

  @@map("bookings")
}

// 4. Tabel Payment (Transaksi Payment Gateway Sandbox)
model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique @map("booking_id")
  paymentMethod String        @default("QRIS / Virtual Account Sandbox") @map("payment_method")
  referenceCode String        @unique @map("reference_code")
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(UNPAID)
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}
