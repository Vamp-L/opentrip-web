<%- include('../partials/head') %>
<body class="min-h-screen bg-[#F7F8FA] text-[#25334A] flex flex-col md:flex-row antialiased">

  <!-- Sidebar Navigasi (Sesuai Referensi Gambar 02) -->
  <%- include('../partials/sidebar', { activePage: 'catalog' }) %>

  <!-- Main Content Area -->
  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar') %>

    <main class="flex-1 p-6 md:p-8 max-w-7xl w-full mx-auto space-y-8">

      <% if (success) { %>
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-[#16A37B] text-sm font-semibold flex items-center justify-between">
          <span><%= success %></span>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-[#DC5555] text-sm font-semibold">
          <%= error %>
        </div>
      <% } %>

      <!-- Hero Banner Sesuai Referensi Gambar 02 -->
      <section class="relative rounded-3xl overflow-hidden shadow-premium bg-[#172B4D] min-h-[300px] md:min-h-[340px] flex flex-col justify-center p-8 md:p-12 text-white">
        <!-- Foto Lanskap Wisata Indonesia Kualitas Tinggi Sebagai Background Utama -->
        <img
          src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1920&q=85"
          alt="Keindahan Alam Indonesia"
          class="absolute inset-0 w-full h-full object-cover object-center opacity-70"
        />
        <!-- Overlay subtle -->
        <div class="absolute inset-0 bg-gradient-to-r from-[#172B4D]/90 via-[#172B4D]/60 to-transparent"></div>

        <div class="relative z-10 max-w-2xl">
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight text-white">
            Jelajahi Keindahan<br/>Indonesia Bersama OpenTrip
          </h1>
          <p class="mt-3 text-sm md:text-base text-slate-200 font-medium leading-relaxed max-w-xl">
            Temukan paket open trip terbaik ke destinasi impianmu, dengan pengalaman tak terlupakan.
          </p>

          <!-- Search Bar & Date Filter Melayang di Bawah Banner Sesuai Gambar Referensi -->
          <form action="/" method="GET" class="mt-6 bg-white p-2 md:p-2.5 rounded-2xl shadow-subtle flex flex-col sm:flex-row items-stretch sm:items-center gap-2 max-w-xl border border-[#E5EAF0]">
            <div class="flex-1 flex items-center gap-2.5 px-3 py-2 text-slate-400">
              <svg class="w-5 h-5 text-[#718096] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                type="text"
                name="q"
                value="<%= search %>"
                placeholder="Cari destinasi, contoh: Bromo, Labuan Bajo..."
                class="w-full bg-transparent text-sm text-[#25334A] placeholder-[#718096] focus:outline-none"
              />
            </div>

            <div class="sm:w-44 flex items-center gap-2 px-3 py-2 border-t sm:border-t-0 sm:border-l border-[#E5EAF0] text-slate-400">
              <svg class="w-4 h-4 text-[#718096] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <input
                type="date"
                name="date"
                value="<%= dateFilter %>"
                class="w-full bg-transparent text-xs text-[#25334A] focus:outline-none cursor-pointer"
              />
            </div>

            <button
              type="submit"
              class="px-6 py-2.5 rounded-xl bg-[#16A6A1] hover:bg-[#128884] text-white font-bold text-xs shadow-subtle transition shrink-0"
            >
              Cari
            </button>
          </form>
        </div>
      </section>

      <!-- Section Title & Filter Urutan Sesuai Referensi Gambar 02 -->
      <section id="katalog-trip">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
          <div>
            <h2 class="text-2xl font-extrabold text-[#172B4D]">Paket Open Trip</h2>
            <p class="text-xs text-[#718096] mt-0.5">Pilihan destinasi terbaik untuk petualanganmu berikutnya.</p>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-xs text-[#718096]">Urutkan:</span>
            <div class="relative">
              <select class="appearance-none bg-white border border-[#E5EAF0] rounded-xl px-4 py-2 pr-8 text-xs font-semibold text-[#172B4D] focus:outline-none focus:ring-1 focus:ring-[#16A6A1] cursor-pointer shadow-subtle">
                <option value="populer">Terpopuler</option>
                <option value="terbaru">Terbaru</option>
                <option value="termurah">Harga Terendah</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-[#718096]">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
          </div>
        </div>

        <% if (trips.length === 0) { %>
          <div class="bg-white rounded-2xl border border-[#E5EAF0] p-12 text-center shadow-subtle">
            <div class="w-12 h-12 rounded-full bg-slate-100 text-[#718096] flex items-center justify-center mx-auto mb-3">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-[#172B4D]">Destinasi Tidak Ditemukan</h3>
            <p class="text-xs text-[#718096] mt-1">Tidak ada paket Open Trip yang sesuai dengan kriteria pencarian Anda.</p>
            <a href="/" class="inline-block mt-4 px-4 py-2 rounded-xl bg-[#16A6A1] text-white text-xs font-bold hover:bg-[#128884] transition">
              Reset Pencarian
            </a>
          </div>
        <% } else { %>
          <!-- Destination Cards Grid (Sesuai Referensi Gambar 02) -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% trips.forEach((trip) => { %>
              <div class="bg-white rounded-2xl border border-[#E5EAF0] overflow-hidden shadow-subtle hover:shadow-cardHover transition duration-300 flex flex-col group">
                <!-- Foto Destinasi Dominan Rasio Card Sesuai Gambar -->
                <div class="relative aspect-card w-full overflow-hidden bg-slate-100">
                  <img
                    src="<%= trip.imageUrl %>"
                    alt="<%= trip.title %>"
                    class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                  />
                  <!-- Badge Destinasi di Kiri Atas Gambar -->
                  <div class="absolute top-3 left-3 px-3 py-1.5 rounded-lg bg-black/50 backdrop-blur-md text-white text-[11px] font-semibold flex items-center gap-1.5 shadow-sm">
                    <svg class="w-3.5 h-3.5 text-[#16A6A1] shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span class="truncate max-w-[160px]"><%= trip.destination %></span>
                  </div>

                  <!-- Badge Kursi di Kanan Atas Gambar -->
                  <div class="absolute top-3 right-3 px-2.5 py-1.5 rounded-lg bg-black/50 backdrop-blur-md text-white text-[11px] font-bold flex items-center gap-1.5 shadow-sm tabular-nums">
                    <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span><%= trip.availableQuota %> / <%= trip.quota %></span>
                  </div>
                </div>

                <!-- Informasi Paket Sesuai Layout Referensi -->
                <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                  <div>
                    <!-- Tanggal Keberangkatan -->
                    <div class="flex items-center gap-1.5 text-[11px] font-semibold text-[#718096] mb-2">
                      <svg class="w-3.5 h-3.5 text-[#16A6A1]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                      <span>Keberangkatan: <%= formatDate(trip.startDate) %></span>
                    </div>

                    <!-- Nama Paket -->
                    <h3 class="text-base font-extrabold text-[#172B4D] leading-snug group-hover:text-[#16A6A1] transition line-clamp-2">
                      <%= trip.title %>
                    </h3>

                    <!-- Deskripsi Ringkas -->
                    <p class="text-xs text-[#718096] mt-2 line-clamp-2 leading-relaxed">
                      <%= trip.description %>
                    </p>
                  </div>

                  <!-- Footer Card: Harga & Tombol Lihat Detail Sesuai Gambar -->
                  <div class="pt-3 border-t border-[#E5EAF0] flex items-center justify-between">
                    <div>
                      <span class="text-base font-extrabold text-[#172B4D] tabular-nums">
                        <%= formatRupiah(trip.price) %>
                      </span>
                      <span class="text-[11px] text-[#718096]">/pax</span>
                    </div>

                    <a
                      href="/trips/<%= trip.id %>"
                      class="inline-flex items-center gap-1 text-xs font-bold text-[#16A6A1] hover:text-[#128884] transition group-hover:translate-x-0.5 duration-200"
                    >
                      <span>Lihat Detail</span>
                      <span class="text-sm">&rarr;</span>
                    </a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

    </main>

    <%- include('../partials/footer') %>
  </div>

</body>
</html>
