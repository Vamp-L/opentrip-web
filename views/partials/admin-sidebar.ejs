<aside class="w-64 bg-[#0F172A] text-white min-h-screen flex flex-col justify-between shrink-0 select-none">
  <div>
    <!-- Brand Header -->
    <div class="px-6 py-6 border-b border-slate-800 flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-[#059669] flex items-center justify-center text-white font-extrabold text-lg shadow">
        N
      </div>
      <div>
        <div class="text-lg font-extrabold tracking-tight text-white leading-none">NusaTrip</div>
        <div class="text-xs font-medium text-emerald-400 mt-1">Admin Panel</div>
      </div>
    </div>

    <!-- Menu Navigasi Sidebar -->
    <nav class="p-4 space-y-1.5">
      <a href="/admin/dashboard"
         class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition <%= activePage === 'dashboard' ? 'bg-[#059669] text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
        </svg>
        <span>Dashboard</span>
      </a>

      <a href="/admin/trips"
         class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition <%= activePage === 'trips' ? 'bg-[#059669] text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <span>Kelola Paket Trip</span>
      </a>

      <a href="/admin/transactions"
         class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition <%= activePage === 'transactions' ? 'bg-[#059669] text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <span>Data Transaksi</span>
      </a>

      <a href="/admin/reports"
         class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition <%= activePage === 'reports' ? 'bg-[#059669] text-white shadow-sm' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %>">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>Laporan Keuangan</span>
      </a>
    </nav>
  </div>

  <!-- Info Admin & Tombol Kembali/Logout -->
  <div class="p-4 border-t border-slate-800 space-y-2">
    <a href="/" class="flex items-center justify-center gap-2 w-full px-3 py-2.5 rounded-xl text-xs font-semibold bg-slate-800 text-slate-200 hover:bg-slate-700 transition">
      <span>Lihat Katalog Publik</span>
    </a>
    <div class="px-3 py-2 flex items-center justify-between">
      <div class="truncate">
        <p class="text-xs font-bold text-white truncate"><%= currentUser ? currentUser.name : 'Administrator' %></p>
        <p class="text-[11px] text-slate-400 truncate"><%= currentUser ? currentUser.email : 'admin@nusatrip.com' %></p>
      </div>
      <a href="/logout" title="Keluar" class="p-2 rounded-lg text-rose-400 hover:bg-slate-800 transition">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
      </a>
    </div>
  </div>
</aside>
