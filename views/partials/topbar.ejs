<!-- Top Bar Header Sesuai Referensi Gambar 02 -->
<header class="h-16 bg-white border-b border-[#E5EAF0] px-6 flex items-center justify-between sticky top-0 z-20">
  <!-- Sisi Kiri: Breadcrumb atau Judul Halaman -->
  <div class="flex items-center gap-3">
    <button id="sidebarToggle" class="md:hidden p-2 text-[#718096] hover:text-[#172B4D] hover:bg-slate-100 rounded-lg">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
    <div class="hidden sm:block text-xs font-semibold text-[#718096]">
      Platform Open Trip Indonesia &bull; Eksplorasi Bersama OpenTrip
    </div>
  </div>

  <!-- Sisi Kanan: Notifikasi & Avatar Pengguna Sesuai Referensi -->
  <div class="flex items-center gap-4">
    <!-- Icon Bell Notifikasi -->
    <div class="relative cursor-pointer p-2 text-[#718096] hover:text-[#172B4D] rounded-full hover:bg-slate-100 transition">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
      </svg>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-[#DC5555]"></span>
    </div>

    <!-- Avatar User -->
    <% if (currentUser) { %>
      <div class="flex items-center gap-2.5 pl-2 border-l border-[#E5EAF0]">
        <% 
          const initials = currentUser.name ? currentUser.name.split(' ').map(n => n[0]).join('').slice(0, 2).toUpperCase() : 'US';
        %>
        <div class="w-9 h-9 rounded-full bg-[#172B4D] text-white flex items-center justify-center font-bold text-xs tracking-wider">
          <%= initials %>
        </div>
        <div class="hidden md:block text-left leading-tight">
          <div class="text-xs font-bold text-[#172B4D]"><%= currentUser.name %></div>
          <div class="text-[10px] font-semibold text-[#16A6A1]"><%= currentUser.role %></div>
        </div>
      </div>
    <% } else { %>
      <a href="/login" class="px-4 py-2 rounded-xl bg-[#172B4D] hover:bg-[#243B5A] text-white text-xs font-bold transition shadow-subtle">
        Masuk / Daftar
      </a>
    <% } %>
  </div>
</header>
