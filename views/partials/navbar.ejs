<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-stone-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-10 h-10 rounded-xl bg-[#059669] flex items-center justify-center text-white shadow-sm group-hover:bg-[#047857] transition">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <span class="text-xl font-extrabold tracking-tight text-[#0F172A]">Nusa<span class="text-[#059669]">Trip</span></span>
      </div>
    </a>

    <!-- Navigation Links (Top Navbar Tanpa Sidebar) -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
      <a href="/" class="<%= currentPath === '/' ? 'text-[#059669]' : 'hover:text-[#0F172A]' %> transition">Jelajah</a>
      <% if (currentUser) { %>
        <a href="/bookings/my" class="<%= currentPath.startsWith('/bookings') ? 'text-[#059669]' : 'hover:text-[#0F172A]' %> transition">Riwayat Trip</a>
      <% } else { %>
        <a href="/login" class="hover:text-[#0F172A] transition">Riwayat Trip</a>
      <% } %>
      <a href="/#destinasi-populer" class="hover:text-[#0F172A] transition">Destinasi</a>
      <a href="#hubungi-kami" class="hover:text-[#0F172A] transition">Hubungi Kami</a>
      <% if (currentUser && currentUser.role === 'ADMIN') { %>
        <a href="/admin/dashboard" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-100 text-[#0F172A] hover:bg-slate-200 transition">
          <span>Panel Admin</span>
        </a>
      <% } %>
    </nav>

    <!-- User / Auth Button -->
    <div class="flex items-center gap-3">
      <% if (currentUser) { %>
        <div class="hidden sm:flex flex-col text-right mr-1">
          <span class="text-xs font-bold text-[#0F172A]"><%= currentUser.name %></span>
          <span class="text-[11px] font-medium text-[#059669]"><%= currentUser.role %></span>
        </div>
        <a href="/bookings/my" class="md:hidden px-3 py-2 text-xs font-semibold text-[#0F172A] bg-stone-100 rounded-lg">Pesanan</a>
        <a href="/logout" class="px-4 py-2.5 rounded-xl text-sm font-semibold border border-stone-300 text-[#0F172A] hover:bg-stone-100 transition">
          Keluar
        </a>
      <% } else { %>
        <a href="/login" class="px-5 py-2.5 rounded-xl text-sm font-semibold bg-[#059669] hover:bg-[#047857] text-white shadow-sm transition">
          Daftar / Login
        </a>
      <% } %>
    </div>
  </div>
</header>
