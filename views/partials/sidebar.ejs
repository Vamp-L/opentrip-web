<!-- Sidebar Navigasi Kiri (Sesuai Referensi Gambar OpenTrip) -->
<aside class="w-64 bg-white border-r border-[#E5EAF0] min-h-screen flex flex-col justify-between shrink-0 select-none z-30 transition-all duration-300">
  <div class="flex flex-col h-full">
    <!-- Brand Header -->
    <div class="px-6 py-6 flex items-center gap-3">
      <a href="/" class="flex items-center gap-2.5">
        <!-- Logo Segitiga Geometris Berwarna Teal Sesuai Referensi -->
        <svg class="w-8 h-8 shrink-0" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M18 4L32 28H4L18 4Z" fill="#16A6A1"/>
          <path d="M18 4L25 28H11L18 4Z" fill="#20B2AA" fill-opacity="0.8"/>
          <path d="M18 4L18 28H4L18 4Z" fill="#0D8B87" fill-opacity="0.5"/>
          <path d="M18 14L28 28H8L18 14Z" fill="#4DD0E1" fill-opacity="0.6"/>
        </svg>
        <span class="text-xl font-extrabold tracking-tight text-[#172B4D]">OpenTrip</span>
      </a>
    </div>

    <!-- Menu Links -->
    <nav class="px-3 py-4 space-y-1.5 flex-1">
      <% if (currentUser && currentUser.role === 'ADMIN') { %>
        <!-- Admin Navigation -->
        <div class="px-4 pb-2 text-[11px] font-bold uppercase tracking-wider text-[#718096]">Admin Area</div>
        
        <a href="/admin/dashboard"
           class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition <%= activePage === 'dashboard' ? 'bg-[#E8F7F7] text-[#16A6A1]' : 'text-[#718096] hover:bg-[#F7F8FA] hover:text-[#172B4D]' %>">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Dashboard</span>
        </a>

        <a href="/admin/trips"
           class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition <%= activePage === 'trips' ? 'bg-[#E8F7F7] text-[#16A6A1]' : 'text-[#718096] hover:bg-[#F7F8FA] hover:text-[#172B4D]' %>">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span>Kelola Paket Trip</span>
        </a>

        <a href="/admin/transactions"
           class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition <%= activePage === 'transactions' ? 'bg-[#E8F7F7] text-[#16A6A1]' : 'text-[#718096] hover:bg-[#F7F8FA] hover:text-[#172B4D]' %>">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <span>Data Transaksi</span>
        </a>

        <a href="/admin/reports"
           class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition <%= activePage === 'reports' ? 'bg-[#E8F7F7] text-[#16A6A1]' : 'text-[#718096] hover:bg-[#F7F8FA] hover:text-[#172B4D]' %>">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Laporan Keuangan</span>
        </a>

        <div class="pt-4 border-t border-[#E5EAF0] mt-4 px-4 pb-2 text-[11px] font-bold uppercase tracking-wider text-[#718096]">Tampilan Pengguna</div>
        <a href="/"
           class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold text-[#718096] hover:bg-[#F7F8FA] hover:text-[#172B4D] transition">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253" />
          </svg>
          <span>Katalog Publik</span>
        </a>

        <!-- Logout Admin -->
        <form action="/logout" method="POST" onsubmit="return confirm('Yakin ingin keluar dari akun admin?');">
          <button type="submit"
                  class="w-full flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold text-[#DC5555] hover:bg-rose-50 transition text-left">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span>Logout</span>
          </button>
        </form>

      <% } else { %>
        <!-- Customer & Public Navigation (Sesuai Referensi Gambar 02) -->
        <a href="/"
           class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition <%= currentPath === '/' ? 'bg-[#E8F7F7] text-[#16A6A1]' : 'text-[#718096] hover:bg-[#F7F8FA] hover:text-[#172B4D]' %>">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="2"/>
            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor"/>
          </svg>
          <span>Catalog</span>
        </a>

        <a href="/bookings/my"
           class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold transition <%= currentPath.startsWith('/bookings') ? 'bg-[#E8F7F7] text-[#16A6A1]' : 'text-[#718096] hover:bg-[#F7F8FA] hover:text-[#172B4D]' %>">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span>My Trip</span>
        </a>

        <% if (currentUser) { %>
          <div class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold text-[#718096]">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <div class="truncate">
              <span class="block truncate text-[#172B4D] font-bold"><%= currentUser.name %></span>
              <span class="text-[11px] text-[#718096]"><%= currentUser.email %></span>
            </div>
          </div>

          <% if (currentUser.role === 'ADMIN') { %>
            <a href="/admin/dashboard"
               class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold text-[#16A6A1] bg-[#E8F7F7] transition">
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <span>Admin Panel</span>
            </a>
          <% } %>

          <a href="/logout"
             class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold text-[#DC5555] hover:bg-rose-50 transition">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span>Logout</span>
          </a>
        <% } else { %>
          <a href="/login"
             class="flex items-center gap-3.5 px-4 py-3 rounded-xl text-sm font-semibold text-[#16A6A1] hover:bg-[#E8F7F7] transition">
            <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
            </svg>
            <span>Login / Daftar</span>
          </a>
        <% } %>
      <% } %>
    </nav>

    <!-- Promo Card di Kiri Bawah Sesuai Referensi Gambar 02 -->
    <div class="p-4">
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#172B4D] to-[#243B5A] p-4 text-white shadow-subtle">
        <div class="relative z-10">
          <h4 class="text-xs font-bold leading-snug">Jelajahi Dunia Bersama OpenTrip</h4>
          <p class="text-[11px] text-slate-300 mt-1">Trip lebih seru, cerita lebih berkesan.</p>
          <a href="/#katalog-trip" class="mt-3 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#16A6A1] hover:bg-[#128884] text-[11px] font-bold text-white transition">
            <span>Tentang OpenTrip</span>
            <span>&rarr;</span>
          </a>
        </div>
        <!-- Ilustrasi background subtle -->
        <div class="absolute -right-4 -bottom-4 w-20 h-20 rounded-full bg-white/5 pointer-events-none"></div>
      </div>
    </div>
  </div>
</aside>
