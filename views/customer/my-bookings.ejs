<%- include('../partials/head') %>
<body class="min-h-screen bg-[#F7F8FA] text-[#25334A] flex flex-col md:flex-row antialiased">

  <%- include('../partials/sidebar', { activePage: 'mytrip' }) %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/topbar') %>

    <main class="flex-1 p-6 md:p-8 max-w-7xl w-full mx-auto space-y-6">

      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[#16A6A1]">Traveler Area</span>
          <h1 class="text-2xl font-extrabold text-[#172B4D] mt-1">My Trip & Riwayat Pesanan</h1>
          <p class="text-xs text-[#718096] mt-0.5">Pantau status transaksi, tiket, dan invoice perjalanan Anda.</p>
        </div>
        <a href="/" class="px-5 py-2.5 rounded-xl bg-[#16A6A1] hover:bg-[#128884] text-white text-xs font-bold shadow-subtle transition w-fit">
          + Cari Trip Baru
        </a>
      </div>

      <% if (success) { %>
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-[#16A37B] text-xs font-semibold">
          <%= success %>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-[#DC5555] text-xs font-semibold">
          <%= error %>
        </div>
      <% } %>

      <% if (bookings.length === 0) { %>
        <div class="bg-white rounded-3xl border border-[#E5EAF0] p-12 text-center shadow-subtle">
          <div class="w-12 h-12 rounded-full bg-slate-100 text-[#718096] flex items-center justify-center mx-auto mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-base font-bold text-[#172B4D]">Belum Ada Perjalanan</h3>
          <p class="text-xs text-[#718096] mt-1">Anda belum memesan paket Open Trip apapun.</p>
          <a href="/" class="inline-block mt-4 px-5 py-2.5 rounded-xl bg-[#16A6A1] text-white text-xs font-bold hover:bg-[#128884] transition">
            Jelajahi Katalog Open Trip
          </a>
        </div>
      <% } else { %>
        <div class="space-y-4">
          <% bookings.forEach((b) => { %>
            <div class="bg-white rounded-3xl border border-[#E5EAF0] p-6 shadow-subtle flex flex-col lg:flex-row lg:items-center justify-between gap-6 hover:border-[#16A6A1]/40 transition duration-200">
              <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
                <img
                  src="<%= b.trip.imageUrl %>"
                  alt="<%= b.trip.title %>"
                  class="w-full sm:w-36 aspect-card object-cover rounded-2xl shrink-0"
                />
                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class="font-mono text-xs font-extrabold text-[#172B4D] bg-[#F7F8FA] border border-[#E5EAF0] px-2.5 py-1 rounded-lg">
                      <%= b.bookingCode %>
                    </span>
                    <% if (b.status === 'PAID') { %>
                      <span class="px-2.5 py-1 rounded-lg bg-emerald-50 text-[#16A37B] border border-emerald-200 text-[11px] font-bold">
                        PAID &bull; LUNAS
                      </span>
                    <% } else if (b.status === 'PENDING') { %>
                      <span class="px-2.5 py-1 rounded-lg bg-amber-50 text-[#E6A23C] border border-amber-200 text-[11px] font-bold">
                        PENDING &bull; MENUNGGU PEMBAYARAN
                      </span>
                    <% } else { %>
                      <span class="px-2.5 py-1 rounded-lg bg-rose-50 text-[#DC5555] border border-rose-200 text-[11px] font-bold">
                        CANCELLED
                      </span>
                    <% } %>
                  </div>

                  <h3 class="text-base font-extrabold text-[#172B4D]"><%= b.trip.title %></h3>
                  <p class="text-xs text-[#718096] mt-1">
                    Keberangkatan: <strong class="text-[#25334A]"><%= formatDate(b.trip.startDate) %></strong> &bull;
                    Peserta: <strong class="text-[#25334A] tabular-nums"><%= b.participants %> Orang</strong> &bull;
                    Metode: <strong class="text-[#25334A]"><%= b.transaction ? b.transaction.paymentMethod : 'NusaPay' %></strong>
                  </p>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row lg:flex-col items-start sm:items-center lg:items-end justify-between gap-3 pt-4 lg:pt-0 border-t lg:border-t-0 border-[#E5EAF0]">
                <div class="text-left lg:text-right">
                  <span class="text-[11px] text-[#718096] block">Total Pembayaran</span>
                  <span class="text-lg font-extrabold text-[#172B4D] tabular-nums block">
                    <%= formatRupiah(b.totalAmount) %>
                  </span>
                </div>

                <div class="flex items-center gap-2.5">
                  <% if (b.status === 'PENDING') { %>
                    <a
                      href="/bookings/<%= b.id %>/payment"
                      class="px-4 py-2.5 rounded-xl bg-[#16A6A1] hover:bg-[#128884] text-white text-xs font-bold transition shadow-subtle"
                    >
                      Bayar Sekarang
                    </a>
                  <% } else { %>
                    <a
                      href="/bookings/<%= b.id %>/payment"
                      class="px-3.5 py-2 rounded-xl border border-[#E5EAF0] text-[#718096] hover:bg-slate-50 text-xs font-semibold transition"
                    >
                      Detail Tagihan
                    </a>
                  <% } %>

                  <a
                    href="/bookings/<%= b.id %>/invoice"
                    class="px-4 py-2.5 rounded-xl bg-[#172B4D] hover:bg-[#243B5A] text-white text-xs font-bold transition inline-flex items-center gap-1.5 shadow-subtle"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>Cetak Invoice</span>
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

    </main>

    <%- include('../partials/footer') %>
  </div>
</body>
</html>
