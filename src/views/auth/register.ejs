<%- include('../partials/head', { title: 'Registrasi Customer' }) %>

<div class="min-h-screen flex flex-col justify-between bg-[#f8f9fe]">
  <!-- Header Banner Gradient Argon -->
  <div class="relative bg-gradient-to-r from-argon-primary to-argon-info pb-36 pt-10 px-4 text-center text-white">
    <div class="max-w-xl mx-auto relative z-10">
      <a href="/catalog" class="inline-flex items-center gap-2.5 mb-3 px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-sm text-xs font-bold tracking-wide">
        <i class="fa-solid fa-compass"></i> OPENTRIP ARGON INDONESIA
      </a>
      <h1 class="text-3xl font-extrabold mb-2">Buat Akun Petualang Baru</h1>
      <p class="text-sm text-white/85">Daftar gratis dan pesan paket liburan Open Trip ke destinasi terbaik Nusantara.</p>
    </div>
  </div>

  <!-- Card Form Register -->
  <div class="max-w-lg w-full mx-auto px-4 -mt-24 relative z-20 mb-12">
    <div class="bg-white rounded-2xl shadow-argon border border-slate-100 p-8">
      <% if (flash) { %>
        <div class="mb-5 p-3.5 rounded-xl text-xs font-semibold flex items-center gap-2.5 <%= flash.type === 'success' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200' %>">
          <i class="fa-solid <%= flash.type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation' %> text-sm"></i>
          <span><%= flash.message %></span>
        </div>
      <% } %>

      <form action="/auth/register" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Nama Lengkap</label>
          <div class="relative">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
              <i class="fa-solid fa-user text-sm"></i>
            </span>
            <input
              type="text"
              name="name"
              required
              placeholder="Contoh: Rina Wijaya"
              class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20 transition"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Alamat Email</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                <i class="fa-solid fa-envelope text-sm"></i>
              </span>
              <input
                type="email"
                name="email"
                required
                placeholder="rina@email.com"
                class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20 transition"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Nomor WhatsApp / HP</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                <i class="fa-solid fa-phone text-sm"></i>
              </span>
              <input
                type="text"
                name="phone"
                required
                placeholder="0812xxxxxxxx"
                class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20 transition"
              />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Password</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                <i class="fa-solid fa-lock text-sm"></i>
              </span>
              <input
                type="password"
                name="password"
                required
                minlength="6"
                placeholder="Minimal 6 karakter"
                class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20 transition"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Ulangi Password</label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400">
                <i class="fa-solid fa-shield-halved text-sm"></i>
              </span>
              <input
                type="password"
                name="confirmPassword"
                required
                minlength="6"
                placeholder="Konfirmasi password"
                class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20 transition"
              />
            </div>
          </div>
        </div>

        <button
          type="submit"
          class="w-full py-3 px-4 rounded-xl bg-argon-primary hover:bg-indigo-600 text-white font-bold text-sm shadow-md hover:shadow-lg transition transform hover:-translate-y-0.5"
        >
          Daftar Akun Customer
        </button>
      </form>

      <div class="mt-6 text-center text-xs text-slate-500">
        Sudah memiliki akun? <a href="/auth/login" class="text-argon-primary font-bold hover:underline">Login di sini</a>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
</div>
