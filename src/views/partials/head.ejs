<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>OpenTrip Argon Indonesia</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <!-- Font Awesome 6 Free -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="stylesheet" href="/css/custom.css" />
  <!-- Tailwind CSS via CDN dengan tema Argon -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
          },
          colors: {
            argon: {
              primary: '#5e72e4',
              secondary: '#8392ab',
              success: '#2dce89',
              info: '#11cdef',
              warning: '#fb6340',
              danger: '#f5365c',
              dark: '#172b4d',
              light: '#f8f9fe'
            }
          },
          boxShadow: {
            'argon': '0 0 2rem 0 rgba(136, 152, 170, 0.15)',
            'argon-sm': '0 0 1rem 0 rgba(136, 152, 170, 0.10)',
          }
        }
      }
    }
  </script>
</head>
<body class="bg-[#f8f9fe] text-slate-700 font-sans antialiased selection:bg-argon-primary selection:text-white">
