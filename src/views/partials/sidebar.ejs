<aside class="fixed inset-y-0 left-0 z-40 w-64 my-4 ml-4 bg-white rounded-2xl shadow-argon border border-slate-100 hidden lg:flex flex-col justify-between transition-all duration-300">
  <div>
    <!-- Brand Logo -->
    <div class="px-6 py-5 border-b border-slate-100 flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-argon-primary to-argon-info flex items-center justify-center text-white shadow-md">
        <i class="fa-solid fa-compass text-lg"></i>
      </div>
      <div>
        <span class="font-extrabold text-argon-dark text-lg tracking-tight block leading-none">OpenTrip</span>
        <span class="text-xs text-slate-400 font-medium">Argon Management</span>
      </div>
    </div>

    <!-- Menu List -->
    <div class="px-4 py-4 space-y-1.5">
      <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Menu Utama</p>

      <% if (currentUser && currentUser.role === 'ADMIN') { %>
        <a href="/admin/dashboard"
           class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all <%= currentPath === '/admin/dashboard' ? 'bg-argon-primary/10 text-argon-primary' : 'text-slate-600 hover:bg-slate-50' %>">
          <div class="w-8 h-8 rounded-lg bg-indigo-50 text-argon-primary flex items-center justify-center">
            <i class="fa-solid fa-tv text-xs"></i>
          </div>
          <span>Dashboard</span>
        </a>

        <a href="/admin/trips"
           class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all <%= currentPath.startsWith('/admin/trips') ? 'bg-argon-primary/10 text-argon-primary' : 'text-slate-600 hover:bg-slate-50' %>">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-argon-success flex items-center justify-center">
            <i class="fa-solid fa-map-location-dot text-xs"></i>
          </div>
          <span>Paket Open Trip</span>
        </a>

        <a href="/admin/transactions"
           class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all <%= currentPath.startsWith('/admin/transactions') ? 'bg-argon-primary/10 text-argon-primary' : 'text-slate-600 hover:bg-slate-50' %>">
          <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
            <i class="fa-solid fa-file-invoice-dollar text-xs"></i>
          </div>
          <span>Daftar Transaksi</span>
        </a>

        <a href="/admin/reports"
           class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all <%= currentPath.startsWith('/admin/reports') ? 'bg-argon-primary/10 text-argon-primary' : 'text-slate-600 hover:bg-slate-50' %>">
          <div class="w-8 h-8 rounded-lg bg-amber-50 text-argon-warning flex items-center justify-center">
            <i class="fa-solid fa-chart-pie text-xs"></i>
          </div>
          <span>Laporan & Keuangan</span>
        </a>

        <div class="pt-3 mt-3 border-t border-slate-100">
          <p class="px-3 text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Pratinjau Publik</p>
          <a href="/catalog"
             class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-all">
            <div class="w-8 h-8 rounded-lg bg-cyan-50 text-argon-info flex items-center justify-center">
              <i class="fa-solid fa-globe text-xs"></i>
            </div>
            <span>Lihat Katalog Trip</span>
          </a>
        </div>
      <% } else { %>
        <a href="/catalog"
           class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all <%= currentPath.startsWith('/catalog') || currentPath.startsWith('/trips') ? 'bg-argon-primary/10 text-argon-primary' : 'text-slate-600 hover:bg-slate-50' %>">
          <div class="w-8 h-8 rounded-lg bg-indigo-50 text-argon-primary flex items-center justify-center">
            <i class="fa-solid fa-mountain-sun text-xs"></i>
          </div>
          <span>Katalog Open Trip</span>
        </a>

        <% if (currentUser && currentUser.role === 'CUSTOMER') { %>
          <a href="/my-bookings"
             class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-semibold transition-all <%= currentPath.startsWith('/my-bookings') || currentPath.startsWith('/bookings') ? 'bg-argon-primary/10 text-argon-primary' : 'text-slate-600 hover:bg-slate-50' %>">
            <div class="w-8 h-8 rounded-lg bg-emerald-50 text-argon-success flex items-center justify-center">
              <i class="fa-solid fa-receipt text-xs"></i>
            </div>
            <span>Pesanan Saya</span>
          </a>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- Info User & Tombol Logout di Bawah Sidebar -->
  <div class="p-4 border-t border-slate-100">
    <% if (currentUser) { %>
      <div class="bg-slate-50 rounded-xl p-3.5 mb-3">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-argon-primary text-white font-bold flex items-center justify-center text-sm uppercase">
            <%= currentUser.name.charAt(0) %>
          </div>
          <div class="overflow-hidden">
            <p class="text-xs font-bold text-argon-dark truncate"><%= currentUser.name %></p>
            <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded-full <%= currentUser.role === 'ADMIN' ? 'bg-indigo-100 text-argon-primary' : 'bg-emerald-100 text-emerald-700' %>">
              <%= currentUser.role %>
            </span>
          </div>
        </div>
      </div>
      <form action="/auth/logout" method="POST">
        <button type="submit" class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-rose-50 hover:bg-rose-100 text-argon-danger font-semibold text-xs transition">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span>Keluar Sesi</span>
        </button>
      </form>
    <% } else { %>
      <div class="space-y-2">
        <a href="/auth/login" class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-argon-primary hover:bg-indigo-600 text-white font-semibold text-xs shadow-sm transition">
          <i class="fa-solid fa-right-to-bracket"></i>
          <span>Login Akun</span>
        </a>
        <a href="/auth/register" class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs transition">
          <i class="fa-solid fa-user-plus"></i>
          <span>Daftar Customer</span>
        </a>
      </div>
    <% } %>
  </div>
</aside>
