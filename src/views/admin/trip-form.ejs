<%- include('../partials/head', { title: title }) %>

<div class="min-h-screen flex flex-col lg:pl-72">
  <!-- Background Header Argon -->
  <div class="fixed top-0 left-0 right-0 h-72 bg-gradient-to-r from-argon-primary to-argon-info -z-10"></div>

  <%- include('../partials/sidebar') %>

  <div class="flex-1 flex flex-col">
    <%- include('../partials/navbar', { pageTitle: pageTitle }) %>

    <main class="px-6 pb-10 flex-1">
      <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-argon border border-slate-100 overflow-hidden">
        <div class="px-6 py-5 border-b border-slate-100 flex items-center justify-between">
          <div>
            <h2 class="text-lg font-extrabold text-argon-dark">
              <%= isEdit ? 'Formulir Edit Paket Open Trip' : 'Formulir Tambah Paket Open Trip Baru' %>
            </h2>
            <p class="text-xs text-slate-400">Lengkapi informasi destinasi, harga, kuota, dan deskripsi fasilitas.</p>
          </div>
          <a href="/admin/trips" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition">
            <i class="fa-solid fa-arrow-left mr-1"></i> Kembali
          </a>
        </div>

        <form
          action="<%= isEdit ? '/admin/trips/' + trip.id + '/update' : '/admin/trips' %>"
          method="POST"
          class="p-6 space-y-5"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Nama Paket Trip -->
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Nama Paket Open Trip *</label>
              <input
                type="text"
                name="title"
                required
                value="<%= isEdit ? trip.title : '' %>"
                placeholder="Contoh: Bromo Midnight Sunrise Adventure"
                class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20"
              />
            </div>

            <!-- Lokasi Destinasi -->
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Destinasi Lokasi *</label>
              <input
                type="text"
                name="destination"
                required
                value="<%= isEdit ? trip.destination : '' %>"
                placeholder="Contoh: Malang & Probolinggo, Jawa Timur"
                class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <!-- Harga Paket -->
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Harga per Peserta (Rp) *</label>
              <input
                type="number"
                name="price"
                min="10000"
                step="1000"
                required
                value="<%= isEdit ? Number(trip.price) : '' %>"
                placeholder="450000"
                class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20"
              />
            </div>

            <!-- Tanggal Keberangkatan -->
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Tanggal Keberangkatan *</label>
              <input
                type="date"
                name="departureDate"
                required
                value="<%= isEdit ? new Date(trip.departureDate).toISOString().split('T')[0] : '' %>"
                class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20"
              />
            </div>

            <!-- Kuota Maksimal -->
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Kuota Maksimal Peserta *</label>
              <input
                type="number"
                id="maxQuotaInput"
                name="maxQuota"
                min="1"
                required
                value="<%= isEdit ? trip.maxQuota : '20' %>"
                oninput="if(!<%= isEdit %>) document.getElementById('remainingQuotaInput').value = this.value"
                class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <!-- Sisa Kuota -->
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Sisa Kuota Saat Ini *</label>
              <input
                type="number"
                id="remainingQuotaInput"
                name="remainingQuota"
                min="0"
                required
                value="<%= isEdit ? trip.remainingQuota : '20' %>"
                class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20"
              />
              <p class="text-[11px] text-slate-400 mt-1">Otomatis berkurang ketika Customer menyelesaikan pembayaran (PAID).</p>
            </div>

            <!-- URL Gambar Sampul -->
            <div>
              <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">URL Gambar Destinasi (Opsional)</label>
              <input
                type="url"
                name="imageUrl"
                value="<%= isEdit && trip.imageUrl ? trip.imageUrl : '' %>"
                placeholder="https://images.unsplash.com/photo-..."
                class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20"
              />
              <p class="text-[11px] text-slate-400 mt-1">Kosongkan untuk menggunakan gambar default.</p>
            </div>
          </div>

          <!-- Deskripsi Paket -->
          <div>
            <label class="block text-xs font-bold uppercase text-slate-600 mb-1.5">Deskripsi Lengkap & Fasilitas *</label>
            <textarea
              name="description"
              rows="5"
              required
              placeholder="Tuliskan itinerary singkat, titik penjemputan, dan fasilitas yang didapatkan peserta..."
              class="w-full px-4 py-2.5 text-sm rounded-xl border border-slate-200 focus:outline-none focus:border-argon-primary focus:ring-2 focus:ring-argon-primary/20"
            ><%= isEdit ? trip.description : '' %></textarea>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
            <a href="/admin/trips" class="px-5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition">
              Batal
            </a>
            <button
              type="submit"
              class="px-6 py-2.5 rounded-xl bg-argon-primary hover:bg-indigo-600 text-white font-bold text-xs shadow-md transition"
            >
              <i class="fa-solid fa-floppy-disk mr-1.5"></i>
              <%= isEdit ? 'Simpan Perubahan' : 'Simpan Paket Trip' %>
            </button>
          </div>
        </form>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </div>
</div>
